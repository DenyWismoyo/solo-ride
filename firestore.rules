rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Users Collection (Profile, Role, KYC Status)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) || isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 2. Orders Collection (Real-time Ride, Food, Delivery Dispatch)
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Wallets Collection (Driver & Merchant Balances)
    match /wallets/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Karcis Collection (Daily Flat Fee Passes)
    match /karcis/{karcisId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Ledger Collection (Financial Mutation Records)
    match /ledger/{ledgerId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit ledger
    }

    // 6. Notifications Collection
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Civic Broadcasts Collection (Pemda & Koperasi Announcements)
    match /broadcasts/{broadcastId} {
      allow read, write: if isAuthenticated();
    }

    // 8. B2B Contracts Collection (Industry Freight & Supply Chain)
    match /contracts/{contractId} {
      allow read, write: if isAuthenticated();
    }

    // 9. Reviews & Ratings Collection
    match /reviews/{reviewId} {
      allow read, write: if isAuthenticated();
    }

    // 10. Menu Items & Catalogs (UMKM Store Menus)
    match /menu_items/{itemId} {
      allow read, write: if isAuthenticated();
    }

    // 11. Live Driver Geolocation GPS
    match /drivers/{driverId} {
      allow read, write: if isAuthenticated();
    }

    // 12. KYC Verification Requests
    match /kyc_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // 13. Dynamic Pricing & Business Formulas (BizConfig)
    match /bizConfig/{configId} {
      allow read, write: if isAuthenticated();
    }
    match /bizconfig/{configId} {
      allow read, write: if isAuthenticated();
    }

    // 14. Merchants, Stamps, and Forum
    match /merchants/{merchantId} {
      allow read, write: if isAuthenticated();
    }
    match /stamps/{stampId} {
      allow read, write: if isAuthenticated();
    }
    match /forum/{forumId} {
      allow read, write: if isAuthenticated();
    }

    // 15. Default Fallback for Application Subcollections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }

  }
}
